{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.co/schema/linux-endpoint/1.0.schema.json",
  "title": "Panopticon Linux endpoint record 1.0",
  "description": "One NDJSON line produced by panopticon-sensord. Envelope and event bodies are closed (additionalProperties false); state items beyond processes are open objects whose fields are documented in the telemetry catalog.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "enum": [
        "event",
        "state",
        "health",
        "loss"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "observed_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "host": {
      "$ref": "#/$defs/Host"
    },
    "sensor": {
      "$ref": "#/$defs/Sensor"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "process": {
      "$ref": "#/$defs/ProcessRef"
    },
    "parent": {
      "$ref": "#/$defs/Process"
    },
    "target": {
      "$ref": "#/$defs/Process"
    },
    "executable": {
      "$ref": "#/$defs/Executable"
    },
    "previous_executable": {
      "type": "string"
    },
    "previous_name": {
      "type": "string"
    },
    "technique": {
      "type": "string"
    },
    "creds_before": {
      "$ref": "#/$defs/CredsBefore"
    },
    "file": {
      "$ref": "#/$defs/File"
    },
    "network": {
      "$ref": "#/$defs/Network"
    },
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "module": {
      "$ref": "#/$defs/Module"
    },
    "mount": {
      "$ref": "#/$defs/Mount"
    },
    "fim": {
      "$ref": "#/$defs/Fim"
    },
    "health": {
      "$ref": "#/$defs/Health"
    },
    "loss": {
      "$ref": "#/$defs/Loss"
    },
    "state": {
      "$ref": "#/$defs/State"
    },
    "unavailable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Unavailable"
      }
    },
    "change": {
      "$ref": "#/$defs/Change"
    },
    "memory": {
      "$ref": "#/$defs/Memory"
    },
    "bpf": {
      "$ref": "#/$defs/Bpf"
    },
    "ns_change": {
      "$ref": "#/$defs/NsChange"
    },
    "dns": {
      "$ref": "#/$defs/Dns"
    },
    "lsm": {
      "$ref": "#/$defs/Lsm"
    },
    "netfilter": {
      "$ref": "#/$defs/Netfilter"
    },
    "response": {
      "$ref": "#/$defs/Response"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "id",
    "seq",
    "type",
    "time",
    "observed_time",
    "host",
    "sensor",
    "provenance",
    "unavailable"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "event"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "health"
              ]
            },
            {
              "required": [
                "loss"
              ]
            },
            {
              "required": [
                "state"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "state"
          }
        }
      },
      "then": {
        "required": [
          "state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "health"
          }
        }
      },
      "then": {
        "required": [
          "health"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "loss"
          }
        }
      },
      "then": {
        "required": [
          "loss"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "state"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "pattern": "^state\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^file\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "file"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^network\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "network"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^auth\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "auth"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^kernel\\.module_"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "module"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^kernel\\.bpf_"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process",
          "bpf"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^memory\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process",
          "memory"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^mount\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "mount"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^fim\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "fim"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^process\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^(posture|interface|account|package|device|firewall)\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "change"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^process\\.ns_change$"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process",
          "ns_change"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^dns\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process",
          "dns"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^lsm\\.denial$"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "process",
          "lsm"
        ],
        "properties": {
          "lsm": {
            "required": [
              "outcome"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^lsm\\.policy$"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "lsm"
        ],
        "properties": {
          "lsm": {
            "not": {
              "required": [
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^netfilter\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "netfilter"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^response\\."
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "response"
        ]
      }
    }
  ],
  "$defs": {
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "Confidence": {
      "enum": [
        "observed",
        "reconstructed",
        "inferred",
        "user_space_reported"
      ]
    },
    "Host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "boot_id",
        "hostname"
      ]
    },
    "Sensor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "policy_version"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "mechanism",
        "confidence"
      ]
    },
    "Unavailable": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_supported_by_provider",
            "process_exited",
            "permission_denied",
            "truncated",
            "budget_exceeded",
            "not_applicable",
            "kernel_feature_missing",
            "object_gone"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ]
    },
    "Hash": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "Executable": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "deleted",
            "memfd",
            "anonymous",
            "unknown"
          ]
        },
        "dev": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "setuid": {
          "type": "boolean"
        },
        "setgid": {
          "type": "boolean"
        },
        "hash": {
          "$ref": "#/$defs/Hash"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "Creds": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "euid": {
          "type": "integer",
          "minimum": 0
        },
        "suid": {
          "type": "integer",
          "minimum": 0
        },
        "fsuid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "egid": {
          "type": "integer",
          "minimum": 0
        },
        "sgid": {
          "type": "integer",
          "minimum": 0
        },
        "fsgid": {
          "type": "integer",
          "minimum": 0
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "loginuid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sessionid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "euid",
        "suid",
        "fsuid",
        "gid",
        "egid",
        "sgid",
        "fsgid",
        "groups",
        "loginuid",
        "sessionid"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "effective": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "permitted": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "inheritable": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "bounding": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "ambient": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "effective",
        "permitted",
        "inheritable",
        "bounding",
        "ambient"
      ]
    },
    "Ancestor": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "entity_id",
        "pid",
        "name",
        "executable"
      ]
    },
    "Process": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "exec_gen": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "vpid": {
          "type": "integer",
          "minimum": 0
        },
        "ppid": {
          "type": "integer",
          "minimum": 0
        },
        "start_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
        },
        "start_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "kernel_thread": {
          "type": "boolean"
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "object",
          "properties": {
            "identity": {
              "enum": [
                "observed",
                "reconstructed",
                "inferred",
                "user_space_reported"
              ]
            },
            "attributes": {
              "enum": [
                "observed",
                "reconstructed",
                "inferred",
                "user_space_reported"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "identity",
            "attributes"
          ]
        },
        "executable": {
          "$ref": "#/$defs/Executable"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args_truncated": {
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        },
        "creds": {
          "$ref": "#/$defs/Creds"
        },
        "caps": {
          "$ref": "#/$defs/Capabilities"
        },
        "seccomp": {
          "type": "integer"
        },
        "no_new_privs": {
          "type": "boolean"
        },
        "ns": {
          "type": "object",
          "properties": {
            "mnt": {
              "type": "integer",
              "minimum": 0
            },
            "pid": {
              "type": "integer",
              "minimum": 0
            },
            "net": {
              "type": "integer",
              "minimum": 0
            },
            "user": {
              "type": "integer",
              "minimum": 0
            },
            "uts": {
              "type": "integer",
              "minimum": 0
            },
            "ipc": {
              "type": "integer",
              "minimum": 0
            },
            "cgroup": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "cgroup": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "container": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{12,64}$"
            },
            "runtime": {
              "enum": [
                "docker",
                "containerd",
                "crio",
                "podman",
                "kubernetes"
              ]
            },
            "pod_uid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "runtime"
          ]
        },
        "tty": {
          "type": "string"
        },
        "pgid": {
          "type": "integer",
          "minimum": 0
        },
        "sid": {
          "type": "integer",
          "minimum": 0
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "exit_signal": {
          "type": "integer"
        },
        "core_dumped": {
          "type": "boolean"
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ancestor"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "exec_gen",
        "pid",
        "ppid",
        "name",
        "state",
        "kernel_thread",
        "threads",
        "confidence",
        "executable",
        "args",
        "args_truncated",
        "creds",
        "caps",
        "ns",
        "pgid",
        "sid"
      ]
    },
    "ProcessStub": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "exec_gen": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pid"
      ]
    },
    "ProcessRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/Process"
        },
        {
          "$ref": "#/$defs/ProcessStub"
        }
      ]
    },
    "CredsBefore": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "euid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "egid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "euid",
        "gid",
        "egid"
      ]
    },
    "File": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "directory": {
          "type": "boolean"
        },
        "old_path": {
          "type": "string"
        },
        "stat": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "integer",
              "minimum": 0
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            },
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "mtime": {
              "type": "string",
